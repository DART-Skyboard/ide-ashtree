// Drift - a real web browser for Samara OS (Ash node syntax).
// ui.web embeds each page in a sandboxed iframe: the host browser engine renders HTML/CSS/JS/SVG/WebGL/video.
// Typed text is passed as-is; the host turns it into a URL or a DuckDuckGo search (normalizeUrl).
// Ash has no lists or string functions, so state is fixed slots shifted with thenplace:
//   (cur)      what the user asked for ('' = start page). Cross-origin frames cannot report their real URL/title.
//   (h1..h8)   back stack, (f1..f8) forward stack, '-' = empty.   (bm1..bm10) bookmarks, (rc1..rc10) recent pages.
// Shared routines are separate nodes run with `call`: DriftGo DriftBack DriftFwd DriftShow DriftSync DriftSaveB DriftSaveR DriftRm1..10.
// Generated by a script from a template; this file is the plain source and can be edited by hand.
import (SamaraHW)
{{env:Samara}}
[[script:drift-v2]]
(Drift):-: {
  [net: https] [poly: browser]
  with var (cur) var (addr) var (target) var (st) var (rl) var (mode) var (mode2) var (modeL) var (modeL2) var (tmp) var (hx) var (hy) var (hc) var (wc) var (hv) var (hcv) var (starL) var (dup) var (ed) var (ev) var (h1) var (h2) var (h3) var (h4) var (h5) var (h6) var (h7) var (h8) var (f1) var (f2) var (f3) var (f4) var (f5) var (f6) var (f7) var (f8) var (bm1) var (bm2) var (bm3) var (bm4) var (bm5) var (bm6) var (bm7) var (bm8) var (bm9) var (bm10) var (bv1) var (bv2) var (bv3) var (bv4) var (bv5) var (bv6) var (bv7) var (bv8) var (bv9) var (bv10) var (rc1) var (rc2) var (rc3) var (rc4) var (rc5) var (rc6) var (rc7) var (rc8) var (rc9) var (rc10) var (rv1) var (rv2) var (rv3) var (rv4) var (rv5) var (rv6) var (rv7) var (rv8) var (rv9) var (rv10) {
    irin ("Data: rl=0 mode=mobile mode2=desktop hx=a hy=b ed=0")
  }
  // defaults, then whatever the user saved
  thenplace "MOBILE ⇄" placeto (modeL)
  thenplace "DESKTOP ⇄" placeto (modeL2)
  thenplace "☆" placeto (starL)
  thenplace "-" placeto (h1)
  thenplace "-" placeto (f1)
  thenplace "-" placeto (h2)
  thenplace "-" placeto (f2)
  thenplace "-" placeto (h3)
  thenplace "-" placeto (f3)
  thenplace "-" placeto (h4)
  thenplace "-" placeto (f4)
  thenplace "-" placeto (h5)
  thenplace "-" placeto (f5)
  thenplace "-" placeto (h6)
  thenplace "-" placeto (f6)
  thenplace "-" placeto (h7)
  thenplace "-" placeto (f7)
  thenplace "-" placeto (h8)
  thenplace "-" placeto (f8)
  call (DriftDefaults)
  store.get (drift.bm.1) placeto (bm1)
  store.get (drift.bm.2) placeto (bm2)
  store.get (drift.bm.3) placeto (bm3)
  store.get (drift.bm.4) placeto (bm4)
  store.get (drift.bm.5) placeto (bm5)
  store.get (drift.bm.6) placeto (bm6)
  store.get (drift.bm.7) placeto (bm7)
  store.get (drift.bm.8) placeto (bm8)
  store.get (drift.bm.9) placeto (bm9)
  store.get (drift.bm.10) placeto (bm10)
  store.get (drift.rc.1) placeto (rc1)
  store.get (drift.rc.2) placeto (rc2)
  store.get (drift.rc.3) placeto (rc3)
  store.get (drift.rc.4) placeto (rc4)
  store.get (drift.rc.5) placeto (rc5)
  store.get (drift.rc.6) placeto (rc6)
  store.get (drift.rc.7) placeto (rc7)
  store.get (drift.rc.8) placeto (rc8)
  store.get (drift.rc.9) placeto (rc9)
  store.get (drift.rc.10) placeto (rc10)
  store.get (drift.mode) placeto (mode)
  store.get (drift.mode2) placeto (mode2)
  store.get (drift.modeL) placeto (modeL)
  store.get (drift.modeL2) placeto (modeL2)
  store.get (drift.hint) placeto (hc)

  // ---- main screen: toolbar, (start page | web view), footer ----
  ui.screen (main) title="Drift" {
    ui.col (tb) gap=8 {
      ui.row (nav) gap=8 {
        ui.button (bback) label="‹" kind=tool
        ui.button (bfwd) label="›" kind=tool
        ui.button (brel) label="↻" kind=tool
        ui.button (bhome) label="⌂" kind=tool
        ui.button (bmode) label=(modeL) kind=mode
        ui.button (bstar) label=(starL) kind=tool
      }
      ui.row (addrrow) gap=8 {
        ui.input (urlin) placeholder="Search or enter address"
        ui.button (bgo) label="Go" kind=go
      }
    }
    ui.button (hint) label="ⓘ Links you tap inside a page navigate the page, but this address bar can't follow them (cross-origin). Tap to hide." kind=hint
    ui.col (home) gap=10 {
      ui.row (srow) gap=8 {
        ui.input (sinput) placeholder="Search or enter address"
        ui.button (sgo) label="Go" kind=go
      }
      ui.text (bmh) text="BOOKMARKS" size=12 color=dim
      ui.col (tilebox) gap=8 {
        ui.grid (tiles) cols=2 gap=8 {
          ui.button (t1) label=(bm1) kind=card
          ui.button (t2) label=(bm2) kind=card
          ui.button (t3) label=(bm3) kind=card
          ui.button (t4) label=(bm4) kind=card
          ui.button (t5) label=(bm5) kind=card
          ui.button (t6) label=(bm6) kind=card
          ui.button (t7) label=(bm7) kind=card
          ui.button (t8) label=(bm8) kind=card
          ui.button (t9) label=(bm9) kind=card
          ui.button (t10) label=(bm10) kind=card
        }
      }
      ui.button (bedit) label="Edit bookmarks" kind=tonal
      ui.text (rch) text="RECENT" size=12 color=dim
      ui.col (rbox) gap=8 {
        ui.grid (recents) cols=2 gap=8 {
          ui.button (r1) label=(rc1) kind=card
          ui.button (r2) label=(rc2) kind=card
          ui.button (r3) label=(rc3) kind=card
          ui.button (r4) label=(rc4) kind=card
          ui.button (r5) label=(rc5) kind=card
          ui.button (r6) label=(rc6) kind=card
          ui.button (r7) label=(rc7) kind=card
          ui.button (r8) label=(rc8) kind=card
          ui.button (r9) label=(rc9) kind=card
          ui.button (r10) label=(rc10) kind=card
        }
      }
      ui.button (hclear) label="Clear history" kind=danger
      ui.text (about) text="Drift shows real pages in a sandboxed frame. A site that refuses to be embedded shows a blank page: use the arrow button on the page to open it in a browser tab." size=12 color=dim
    }
    ui.col (editbox) gap=8 {
      ui.text (eh) text="Tap a bookmark to open it, or ✕ to remove it. Add the page you are on with the star in the toolbar." size=13 color=dim
      ui.col (erows) gap=8 {
        ui.row (er1) gap=8 {
          ui.button (el1) label=(bm1) kind=card
          ui.button (ex1) label="✕" kind=x
        }
        ui.row (er2) gap=8 {
          ui.button (el2) label=(bm2) kind=card
          ui.button (ex2) label="✕" kind=x
        }
        ui.row (er3) gap=8 {
          ui.button (el3) label=(bm3) kind=card
          ui.button (ex3) label="✕" kind=x
        }
        ui.row (er4) gap=8 {
          ui.button (el4) label=(bm4) kind=card
          ui.button (ex4) label="✕" kind=x
        }
        ui.row (er5) gap=8 {
          ui.button (el5) label=(bm5) kind=card
          ui.button (ex5) label="✕" kind=x
        }
        ui.row (er6) gap=8 {
          ui.button (el6) label=(bm6) kind=card
          ui.button (ex6) label="✕" kind=x
        }
        ui.row (er7) gap=8 {
          ui.button (el7) label=(bm7) kind=card
          ui.button (ex7) label="✕" kind=x
        }
        ui.row (er8) gap=8 {
          ui.button (el8) label=(bm8) kind=card
          ui.button (ex8) label="✕" kind=x
        }
        ui.row (er9) gap=8 {
          ui.button (el9) label=(bm9) kind=card
          ui.button (ex9) label="✕" kind=x
        }
        ui.row (er10) gap=8 {
          ui.button (el10) label=(bm10) kind=card
          ui.button (ex10) label="✕" kind=x
        }
      }
      ui.button (brestore) label="Restore default bookmarks" kind=tonal
      ui.button (edone) label="Done" kind=primary
    }
    ui.web (view) url=(cur) mode=(mode) reload=(rl) h=(hx)
    ui.text (foot) text=(st) size=11
  }

  // visibility classes are computed by DriftSync (bound live)
  ui.set (t1) cls=(bv1)
  ui.set (er1) cls=(bv1)
  ui.set (t2) cls=(bv2)
  ui.set (er2) cls=(bv2)
  ui.set (t3) cls=(bv3)
  ui.set (er3) cls=(bv3)
  ui.set (t4) cls=(bv4)
  ui.set (er4) cls=(bv4)
  ui.set (t5) cls=(bv5)
  ui.set (er5) cls=(bv5)
  ui.set (t6) cls=(bv6)
  ui.set (er6) cls=(bv6)
  ui.set (t7) cls=(bv7)
  ui.set (er7) cls=(bv7)
  ui.set (t8) cls=(bv8)
  ui.set (er8) cls=(bv8)
  ui.set (t9) cls=(bv9)
  ui.set (er9) cls=(bv9)
  ui.set (t10) cls=(bv10)
  ui.set (er10) cls=(bv10)
  ui.set (r1) cls=(rv1)
  ui.set (r2) cls=(rv2)
  ui.set (r3) cls=(rv3)
  ui.set (r4) cls=(rv4)
  ui.set (r5) cls=(rv5)
  ui.set (r6) cls=(rv6)
  ui.set (r7) cls=(rv7)
  ui.set (r8) cls=(rv8)
  ui.set (r9) cls=(rv9)
  ui.set (r10) cls=(rv10)
  ui.set (rch) cls=(rv1)
  ui.set (hclear) cls=(rv1)
  ui.set (view) cls=(wc)
  ui.set (addrrow) cls=(wc)
  ui.set (foot) cls=(wc)
  ui.set (home) cls=(hv)
  ui.set (editbox) cls=(ev)
  ui.set (hint) cls=(hcv)
  call (DriftSync)

  // ---- handlers ----
  ui.on (urlin) submit {
    thenplace (urlin) placeto (target)
    Research (rl + 1) placeto (rl)
    call (DriftGo)
  }
  ui.on (bgo) tap {
    thenplace (urlin) placeto (target)
    Research (rl + 1) placeto (rl)
    call (DriftGo)
  }
  ui.on (sinput) submit {
    thenplace (sinput) placeto (target)
    call (DriftGo)
    thenplace "" placeto (sinput)
    ui.set (sinput) value=(sinput)
  }
  ui.on (sgo) tap {
    thenplace (sinput) placeto (target)
    call (DriftGo)
    thenplace "" placeto (sinput)
    ui.set (sinput) value=(sinput)
  }
  ui.on (bback) tap { call (DriftBack) }
  ui.on (bfwd) tap { call (DriftFwd) }
  ui.on (brel) tap {
    Research (rl + 1) placeto (rl)
    thenplace "Loading ${cur} ..." placeto (st)
  }
  ui.on (bhome) tap {
    if cond="${cur}!=" {
      thenplace "" placeto (target)
      call (DriftGo)
    }
  }
  ui.on (bmode) tap {
    thenplace (mode) placeto (tmp)
    thenplace (mode2) placeto (mode)
    thenplace (tmp) placeto (mode2)
    thenplace (modeL) placeto (tmp)
    thenplace (modeL2) placeto (modeL)
    thenplace (tmp) placeto (modeL2)
    store.set (drift.mode) with (mode)
    store.set (drift.mode2) with (mode2)
    store.set (drift.modeL) with (modeL)
    store.set (drift.modeL2) with (modeL2)
    thenplace "Loaded ${cur} - ${mode} layout" placeto (st)
  }
  ui.on (bstar) tap {
    if cond="${cur}!=" {
      thenplace "0" placeto (dup)
      if cond="${bm1}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm2}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm3}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm4}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm5}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm6}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm7}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm8}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm9}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${bm10}==${cur}" { thenplace "1" placeto (dup) }
      if cond="${dup}==0" {
        thenplace (bm9) placeto (bm10)
        thenplace (bm8) placeto (bm9)
        thenplace (bm7) placeto (bm8)
        thenplace (bm6) placeto (bm7)
        thenplace (bm5) placeto (bm6)
        thenplace (bm4) placeto (bm5)
        thenplace (bm3) placeto (bm4)
        thenplace (bm2) placeto (bm3)
        thenplace (bm1) placeto (bm2)
        thenplace (cur) placeto (bm1)
        call (DriftSaveB)
        call (DriftSync)
        sys.notify ("Bookmarked") title="Drift"
      }
      if cond="${dup}==1" {
        if cond="${bm1}==${cur}" { call (DriftRm1) }
        if cond="${bm2}==${cur}" { call (DriftRm2) }
        if cond="${bm3}==${cur}" { call (DriftRm3) }
        if cond="${bm4}==${cur}" { call (DriftRm4) }
        if cond="${bm5}==${cur}" { call (DriftRm5) }
        if cond="${bm6}==${cur}" { call (DriftRm6) }
        if cond="${bm7}==${cur}" { call (DriftRm7) }
        if cond="${bm8}==${cur}" { call (DriftRm8) }
        if cond="${bm9}==${cur}" { call (DriftRm9) }
        if cond="${bm10}==${cur}" { call (DriftRm10) }
        sys.notify ("Bookmark removed") title="Drift"
      }
    }
  }
  ui.on (hint) tap {
    thenplace "dhide" placeto (hc)
    store.set (drift.hint) with (hc)
    call (DriftSync)
  }
  ui.on (view) load {
    thenplace "Loaded ${cur} - ${mode} layout" placeto (st)
  }
  ui.on (bedit) tap {
    thenplace "1" placeto (ed)
    call (DriftSync)
  }
  ui.on (edone) tap {
    thenplace "0" placeto (ed)
    call (DriftSync)
  }
  ui.on (hclear) tap {
    thenplace "" placeto (rc1)
    thenplace "" placeto (rc2)
    thenplace "" placeto (rc3)
    thenplace "" placeto (rc4)
    thenplace "" placeto (rc5)
    thenplace "" placeto (rc6)
    thenplace "" placeto (rc7)
    thenplace "" placeto (rc8)
    thenplace "" placeto (rc9)
    thenplace "" placeto (rc10)
    call (DriftSaveR)
    thenplace "-" placeto (h1)
    thenplace "-" placeto (f1)
    thenplace "-" placeto (h2)
    thenplace "-" placeto (f2)
    thenplace "-" placeto (h3)
    thenplace "-" placeto (f3)
    thenplace "-" placeto (h4)
    thenplace "-" placeto (f4)
    thenplace "-" placeto (h5)
    thenplace "-" placeto (f5)
    thenplace "-" placeto (h6)
    thenplace "-" placeto (f6)
    thenplace "-" placeto (h7)
    thenplace "-" placeto (f7)
    thenplace "-" placeto (h8)
    thenplace "-" placeto (f8)
    call (DriftSync)
    sys.notify ("History cleared") title="Drift"
  }
  ui.on (brestore) tap {
    call (DriftDefaults)
    call (DriftSaveB)
    call (DriftSync)
  }
  ui.on (t1) tap { thenplace (bm1) placeto (target); call (DriftGo) }
  ui.on (el1) tap { thenplace (bm1) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex1) tap { call (DriftRm1) }
  ui.on (t2) tap { thenplace (bm2) placeto (target); call (DriftGo) }
  ui.on (el2) tap { thenplace (bm2) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex2) tap { call (DriftRm2) }
  ui.on (t3) tap { thenplace (bm3) placeto (target); call (DriftGo) }
  ui.on (el3) tap { thenplace (bm3) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex3) tap { call (DriftRm3) }
  ui.on (t4) tap { thenplace (bm4) placeto (target); call (DriftGo) }
  ui.on (el4) tap { thenplace (bm4) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex4) tap { call (DriftRm4) }
  ui.on (t5) tap { thenplace (bm5) placeto (target); call (DriftGo) }
  ui.on (el5) tap { thenplace (bm5) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex5) tap { call (DriftRm5) }
  ui.on (t6) tap { thenplace (bm6) placeto (target); call (DriftGo) }
  ui.on (el6) tap { thenplace (bm6) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex6) tap { call (DriftRm6) }
  ui.on (t7) tap { thenplace (bm7) placeto (target); call (DriftGo) }
  ui.on (el7) tap { thenplace (bm7) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex7) tap { call (DriftRm7) }
  ui.on (t8) tap { thenplace (bm8) placeto (target); call (DriftGo) }
  ui.on (el8) tap { thenplace (bm8) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex8) tap { call (DriftRm8) }
  ui.on (t9) tap { thenplace (bm9) placeto (target); call (DriftGo) }
  ui.on (el9) tap { thenplace (bm9) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex9) tap { call (DriftRm9) }
  ui.on (t10) tap { thenplace (bm10) placeto (target); call (DriftGo) }
  ui.on (el10) tap { thenplace (bm10) placeto (target); thenplace "0" placeto (ed); call (DriftGo) }
  ui.on (ex10) tap { call (DriftRm10) }
  ui.on (r1) tap { thenplace (rc1) placeto (target); call (DriftGo) }
  ui.on (r2) tap { thenplace (rc2) placeto (target); call (DriftGo) }
  ui.on (r3) tap { thenplace (rc3) placeto (target); call (DriftGo) }
  ui.on (r4) tap { thenplace (rc4) placeto (target); call (DriftGo) }
  ui.on (r5) tap { thenplace (rc5) placeto (target); call (DriftGo) }
  ui.on (r6) tap { thenplace (rc6) placeto (target); call (DriftGo) }
  ui.on (r7) tap { thenplace (rc7) placeto (target); call (DriftGo) }
  ui.on (r8) tap { thenplace (rc8) placeto (target); call (DriftGo) }
  ui.on (r9) tap { thenplace (rc9) placeto (target); call (DriftGo) }
  ui.on (r10) tap { thenplace (rc10) placeto (target); call (DriftGo) }
  input.on (forward) {
    if cond="${ed}==0" { call (DriftFwd) }
  }
  input.on (back) {
    if cond="${ed}==0" {
      if cond="${cur}!=" { call (DriftBack) }
      if cond="${cur}==" { sys.home }
    }
    if cond="${ed}==1" {
      thenplace "0" placeto (ed)
      call (DriftSync)
    }
  }
  ui.screen (main)
}|';'|

// Default bookmarks (own sites first, then sites that allow framing); empty recents.
(DriftDefaults):-: {
  thenplace "dartmeadow.com" placeto (bm1)
  thenplace "radicaldeepscale.com" placeto (bm2)
  thenplace "leatr.xyz" placeto (bm3)
  thenplace "cube.leatr.xyz" placeto (bm4)
  thenplace "en.wikipedia.org" placeto (bm5)
  thenplace "threejs.org/examples" placeto (bm6)
  thenplace "developer.mozilla.org" placeto (bm7)
  thenplace "archive.org" placeto (bm8)
  thenplace "openstreetmap.org" placeto (bm9)
  thenplace "" placeto (bm10)
  thenplace "" placeto (rc1)
  thenplace "" placeto (rc2)
  thenplace "" placeto (rc3)
  thenplace "" placeto (rc4)
  thenplace "" placeto (rc5)
  thenplace "" placeto (rc6)
  thenplace "" placeto (rc7)
  thenplace "" placeto (rc8)
  thenplace "" placeto (rc9)
  thenplace "" placeto (rc10)
}|';'|

// Navigate to (target): push (cur) on the back stack, clear forward, remember in recents.
(DriftGo):-: {
  thenplace (h7) placeto (h8)
  thenplace (h6) placeto (h7)
  thenplace (h5) placeto (h6)
  thenplace (h4) placeto (h5)
  thenplace (h3) placeto (h4)
  thenplace (h2) placeto (h3)
  thenplace (h1) placeto (h2)
  thenplace (cur) placeto (h1)
  thenplace "-" placeto (f1)
  thenplace "-" placeto (f2)
  thenplace "-" placeto (f3)
  thenplace "-" placeto (f4)
  thenplace "-" placeto (f5)
  thenplace "-" placeto (f6)
  thenplace "-" placeto (f7)
  thenplace "-" placeto (f8)
  thenplace (target) placeto (cur)
  if cond="${target}!=" {
    if cond="${rc1}!=${target}" {
      thenplace (rc9) placeto (rc10)
      thenplace (rc8) placeto (rc9)
      thenplace (rc7) placeto (rc8)
      thenplace (rc6) placeto (rc7)
      thenplace (rc5) placeto (rc6)
      thenplace (rc4) placeto (rc5)
      thenplace (rc3) placeto (rc4)
      thenplace (rc2) placeto (rc3)
      thenplace (rc1) placeto (rc2)
      thenplace (target) placeto (rc1)
    }
  }
  call (DriftSaveR)
  call (DriftShow)
}|';'|

// Back: current page goes on the forward stack.
(DriftBack):-: {
  if cond="${h1}!=-" {
    thenplace (f7) placeto (f8)
    thenplace (f6) placeto (f7)
    thenplace (f5) placeto (f6)
    thenplace (f4) placeto (f5)
    thenplace (f3) placeto (f4)
    thenplace (f2) placeto (f3)
    thenplace (f1) placeto (f2)
    thenplace (cur) placeto (f1)
    thenplace (h1) placeto (cur)
    thenplace (h2) placeto (h1)
    thenplace (h3) placeto (h2)
    thenplace (h4) placeto (h3)
    thenplace (h5) placeto (h4)
    thenplace (h6) placeto (h5)
    thenplace (h7) placeto (h6)
    thenplace (h8) placeto (h7)
    thenplace "-" placeto (h8)
    call (DriftShow)
  }
}|';'|

// Forward: current page goes back on the back stack.
(DriftFwd):-: {
  if cond="${f1}!=-" {
    thenplace (h7) placeto (h8)
    thenplace (h6) placeto (h7)
    thenplace (h5) placeto (h6)
    thenplace (h4) placeto (h5)
    thenplace (h3) placeto (h4)
    thenplace (h2) placeto (h3)
    thenplace (h1) placeto (h2)
    thenplace (cur) placeto (h1)
    thenplace (f1) placeto (cur)
    thenplace (f2) placeto (f1)
    thenplace (f3) placeto (f2)
    thenplace (f4) placeto (f3)
    thenplace (f5) placeto (f4)
    thenplace (f6) placeto (f5)
    thenplace (f7) placeto (f6)
    thenplace (f8) placeto (f7)
    thenplace "-" placeto (f8)
    call (DriftShow)
  }
}|';'|

// After (cur) changed: sync the address bar, status and which area is visible.
(DriftShow):-: {
  thenplace (cur) placeto (addr)
  ui.set (urlin) value=(addr)
  thenplace "Loading ${cur} ..." placeto (st)
  call (DriftSync)
}|';'|

// Recompute visibility classes (dhide) and the bookmark star. Also nudges the web view to re-fit its height.
(DriftSync):-: {
  thenplace "" placeto (wc)
  thenplace "dhide" placeto (hv)
  thenplace (hc) placeto (hcv)
  if cond="${cur}==" {
    thenplace "dhide" placeto (wc)
    thenplace "" placeto (hv)
    thenplace "dhide" placeto (hcv)
  }
  thenplace "dhide" placeto (bv1)
  if cond="${bm1}!=" { thenplace "" placeto (bv1) }
  thenplace "dhide" placeto (bv2)
  if cond="${bm2}!=" { thenplace "" placeto (bv2) }
  thenplace "dhide" placeto (bv3)
  if cond="${bm3}!=" { thenplace "" placeto (bv3) }
  thenplace "dhide" placeto (bv4)
  if cond="${bm4}!=" { thenplace "" placeto (bv4) }
  thenplace "dhide" placeto (bv5)
  if cond="${bm5}!=" { thenplace "" placeto (bv5) }
  thenplace "dhide" placeto (bv6)
  if cond="${bm6}!=" { thenplace "" placeto (bv6) }
  thenplace "dhide" placeto (bv7)
  if cond="${bm7}!=" { thenplace "" placeto (bv7) }
  thenplace "dhide" placeto (bv8)
  if cond="${bm8}!=" { thenplace "" placeto (bv8) }
  thenplace "dhide" placeto (bv9)
  if cond="${bm9}!=" { thenplace "" placeto (bv9) }
  thenplace "dhide" placeto (bv10)
  if cond="${bm10}!=" { thenplace "" placeto (bv10) }
  thenplace "dhide" placeto (rv1)
  if cond="${rc1}!=" { thenplace "" placeto (rv1) }
  thenplace "dhide" placeto (rv2)
  if cond="${rc2}!=" { thenplace "" placeto (rv2) }
  thenplace "dhide" placeto (rv3)
  if cond="${rc3}!=" { thenplace "" placeto (rv3) }
  thenplace "dhide" placeto (rv4)
  if cond="${rc4}!=" { thenplace "" placeto (rv4) }
  thenplace "dhide" placeto (rv5)
  if cond="${rc5}!=" { thenplace "" placeto (rv5) }
  thenplace "dhide" placeto (rv6)
  if cond="${rc6}!=" { thenplace "" placeto (rv6) }
  thenplace "dhide" placeto (rv7)
  if cond="${rc7}!=" { thenplace "" placeto (rv7) }
  thenplace "dhide" placeto (rv8)
  if cond="${rc8}!=" { thenplace "" placeto (rv8) }
  thenplace "dhide" placeto (rv9)
  if cond="${rc9}!=" { thenplace "" placeto (rv9) }
  thenplace "dhide" placeto (rv10)
  if cond="${rc10}!=" { thenplace "" placeto (rv10) }
  thenplace "dhide" placeto (ev)
  if cond="${ed}==1" {
    thenplace "dhide" placeto (hv)
    thenplace "" placeto (ev)
  }
  thenplace "☆" placeto (starL)
  if cond="${cur}!=" {
    if cond="${bm1}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm2}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm3}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm4}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm5}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm6}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm7}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm8}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm9}==${cur}" { thenplace "★" placeto (starL) }
    if cond="${bm10}==${cur}" { thenplace "★" placeto (starL) }
  }
  thenplace (hx) placeto (tmp)
  thenplace (hy) placeto (hx)
  thenplace (tmp) placeto (hy)
}|';'|

// Persist bookmarks.
(DriftSaveB):-: {
  store.set (drift.bm.1) with (bm1)
  store.set (drift.bm.2) with (bm2)
  store.set (drift.bm.3) with (bm3)
  store.set (drift.bm.4) with (bm4)
  store.set (drift.bm.5) with (bm5)
  store.set (drift.bm.6) with (bm6)
  store.set (drift.bm.7) with (bm7)
  store.set (drift.bm.8) with (bm8)
  store.set (drift.bm.9) with (bm9)
  store.set (drift.bm.10) with (bm10)
}|';'|

// Persist recent pages.
(DriftSaveR):-: {
  store.set (drift.rc.1) with (rc1)
  store.set (drift.rc.2) with (rc2)
  store.set (drift.rc.3) with (rc3)
  store.set (drift.rc.4) with (rc4)
  store.set (drift.rc.5) with (rc5)
  store.set (drift.rc.6) with (rc6)
  store.set (drift.rc.7) with (rc7)
  store.set (drift.rc.8) with (rc8)
  store.set (drift.rc.9) with (rc9)
  store.set (drift.rc.10) with (rc10)
}|';'|

// Remove bookmark 1: later bookmarks shift up.
(DriftRm1):-: {
  thenplace (bm2) placeto (bm1)
  thenplace (bm3) placeto (bm2)
  thenplace (bm4) placeto (bm3)
  thenplace (bm5) placeto (bm4)
  thenplace (bm6) placeto (bm5)
  thenplace (bm7) placeto (bm6)
  thenplace (bm8) placeto (bm7)
  thenplace (bm9) placeto (bm8)
  thenplace (bm10) placeto (bm9)
  thenplace "" placeto (bm10)
  call (DriftSaveB)
  call (DriftSync)
}|';'|

