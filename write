  "phone/apps/tally.ashos": "// Tally - calculator for Samara OS (Ash node syntax).\n// Evaluation is real: Research (expr) parses the expression text held in the string var expr.\n// Ash has no branching, so Backspace is an undo stack (u1..u6); every key pushes the old expression.\nimport (SamaraHW)\n{{env:Samara}}\n[[script:tally-v1]]\n(Tally):-: {\n  [net: none] [poly: arithmetic]\n  with var (s) var (expr) var (res) var (hist) var (u1) var (u2) var (u3) var (u4) var (u5) var (u6) {\n    irin (\"Data: res=0\")\n  }\n  thenplace \"\" placeto (expr)\n  thenplace \"\" placeto (hist)\n  thenplace \"\" placeto (u1)\n  thenplace \"\" placeto (u2)\n  thenplace \"\" placeto (u3)\n  thenplace \"\" placeto (u4)\n  thenplace \"\" placeto (u5)\n  thenplace \"\" placeto (u6)\n  store.get (tally.hist) placeto (hist)\n\n  ui.screen (calc) title=\"Tally\" {\n    ui.text (disp) text=(expr) size=40 align=right\n    ui.text (out) text=(res) size=22 align=right color=dim\n    ui.grid (pad) cols=4 gap=6 {\n      ui.button (kac) label=\"AC\" kind=acc\n      ui.button (kbs) label=\"⌫\" kind=fn\n      ui.button (kpc) label=\"%\" kind=fn\n      ui.button (kdv) label=\"÷\" kind=op\n      ui.button (k7) label=\"7\"\n      ui.button (k8) label=\"8\"\n      ui.button (k9) label=\"9\"\n      ui.button (kmu) label=\"×\" kind=op\n      ui.button (k4) label=\"4\"\n      ui.button (k5) label=\"5\"\n      ui.button (k6) label=\"6\"\n      ui.button (kmi) label=\"−\" kind=op\n      ui.button (k1) label=\"1\"\n      ui.button (k2) label=\"2\"\n      ui.button (k3) label=\"3\"\n      ui.button (kpl) label=\"+\" kind=op\n      ui.button (ksg) label=\"±\" kind=fn\n      ui.button (k0) label=\"0\"\n      ui.button (kdt) label=\".\"\n      ui.button (keq) label=\"=\" kind=eq\n    }\n    ui.row (tools) gap=8 {\n      ui.button (hbtn) label=\"History\" kind=tonal\n      ui.button (qbtn) label=\"Home\" kind=tonal\n    }\n  }\n  ui.screen (histscr) title=\"Tally history\" {\n    ui.list (hl) items=(hist)\n  