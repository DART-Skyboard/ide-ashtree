  "phone/os/samara.ashos": "// Samara OS 1.0 - demo OS image source (Ash node syntax).\n// Compile together with the apps:\n//   Seedpress.compile({ files:{ 'phone/os/samara.ashos':..., 'phone/apps/tally.ashos':..., ... }, entry:'phone/os/samara.ashos' })\nimport (SamaraHW)\n{{env:Samara}}\n[[script:samara-os-v1]]\n\n// ---- manifest (lifted into seed.manifest by Seedpress) ----\n// Default theme. Themes the OS ships (switch live in Rings via sys.setting (theme)):\n//   ash (default, Ash Dark) | Ash Light | Ember | Moss | Mist | Midnight\nsys.theme (ash)\nsys.layout grid=4x5 dock=4\nsys.boot (Crown)\n\nsys.app (tally) name=\"Tally\" glyph=\"±\" color=#ff9500 entry=Tally\nsys.app (leaf)  name=\"Leaf\"  glyph=\"❦\" color=#34c759 entry=Leaf\nsys.app (drift) name=\"Drift\" glyph=\"◎\" color=#0a84ff entry=Drift\nsys.app (lens)  name=\"Lens\"  glyph=\"◉\" color=#bf5af2 entry=Lens\nsys.app (rings) name=\"Rings\" glyph=\"⚙\" color=#8e8e93 entry=Rings\nsys.app (widow) name=\"Widow\" glyph=\"◈\" color=#5e5ce6 entry=Widow\n\n// ---- Crown: home, Bark (lock), notification shade, app menu ----\n(Crown):-: {\n  [net: none] [poly: shell]\n  with var (now) var (pct) var (inbox) var (s) {\n    irin (\"Data: s=0\")\n  }\n  sys.clock placeto (now)\n  power.battery placeto (pct)\n  thenplace \"Welcome to Samara OS\" placeto (inbox)\n\n  ui.screen (home) title=\"Crown\" {\n    ui.col (widget) gap=4 {\n      ui.text (clk) text=(now) size=clock align=center\n      ui.text (bat) text=\"Battery ${pct}%\" size=14 align=center color=dim\n    }\n    ui.row (dockbar) gap=8 {\n      ui.button (hshade) label=\"Notifications\" kind=glass\n      ui.button (hmenu) label=\"All apps\" kind=glass\n      ui.button (hlock) label=\"Lock\" kind=glass\n    }\n  }\n\n  ui.screen (menu) title=\"Apps\" {\n    ui.grid (mgrid) cols=2 gap=8 {\n      ui.button (mtally) label=\"Tally  (calculator)\"\n      ui.button (mleaf) label=\"Leaf  (notes)\"\n      ui.button (mdrift) label=\"Drift  (browser)\"\n      ui.button (mlens) label=\"Lens  (camera)\"\n      ui.button (mrings) label=\"Rings  (settings)\"\n      ui.button (mwidow) label=\"Widow  (windows + widgets)\"\n    }\n    ui.button (mback) label=\"Back to home\" kind=tonal\n  }\n\n  ui.screen (shade) title=\"Notifications\" {\n    ui.list (inboxl) items=(inbox)\n    ui.row (qs1) gap=8 {\n      ui.button (qdim) label=\"Dim\"\n      ui.button (qmid) label=\"Medium\"\n      ui.button (qbright) label=\"Bright\"\n    }\n    ui.row (qs2) gap=8 {\n      ui.button (qtest) label=\"Test notification\"\n      ui.button (qclear) label=\"Clear\"\n      ui.button (qclose) label=\"Close\"\n    }\n  }\n\n  ui.screen (bark) title=\"Bark\" {\n    ui.text (bclk) text=(now) size=64 align=center\n    ui.text (bhint) text=\"Tap Unlock to enter Crown\" size=14 align=center color=dim\n    ui.text (bnotif) text=(inbox) size=14 align=center\n    ui.button (bunlock) label=\"Unlock\"\n  }\n\n  ui.on (hshade) tap { ui.set (inboxl) items=(inbox); ui.screen (shade) }\n  ui.on (hmenu) tap { ui.screen (menu) }\n  ui.on (hlock) tap {\n    sys.clock placeto (now)\n    ui.set (bclk) text=(now)\n    ui.screen (home)\n  }\n  ui.on (bunlock) tap {\n    sys.clock placeto (now)\n    power.battery placeto (pct)\n    ui.set (clk) text=(now)\n    ui.set (bat) text=\"Battery ${pct}%\"\n    sys.home\n  }\n  ui.on (mtally) tap { sys.launch (tally) }\n  ui.on (mleaf) tap { sys.launch (leaf) }\n  ui.on (mdrift) tap { sys.launch (drift) }\n  ui.on (mlens) tap { sys.launch (lens) }\n  ui.on (mrings) tap { sys.launch (rings) }\n  ui.on (mwidow) tap { sys.launch (widow) }\n  ui.on (mback) tap { ui.screen (home) }\n  ui.on (qdim) tap { sys.setting (brightness) 0.3 }\n  ui.on (qmid) tap { sys.setting (brightness) 0.6 }\n  ui.on (qbright) tap { sys.setting (brightness) 1.0 }\n  ui.on (qtest) tap {\n    sys.clock placeto (now)\n    sys.notify (\"Hello from Crown\") title=\"Samara\"\n    thenplace \"${now}  Hello from Crown,${inbox}\" placeto (inbox)\n    ui.set (inboxl) items=(inbox)\n  }\n  ui.on (qclear) tap {\n    thenplace \"\" placeto (inbox)\n    ui.set (inboxl) items=(inbox)\n  }\n  ui.on (qclose) tap { ui.screen (home) }\n\n  // hardware keys\n  input.on (home) { ui.screen (home) }\n  input.on (back) { ui.screen (home) }\n  input.on (power) {\n    power.sleep\n    sys.clock placeto (now)\n    ui.set (bclk) text=(now)\n    ui.screen (home)\n  }\n  input.on (volup) { snd.volume (1) }\n  input.on (voldown) { snd.volume (0.3) }\n\n  ui.screen (home)\n}|';'|\n\n// ---- Rings: settings ----\n(Rings):-: {\n  [net: none] [poly: settings]\n  with var (s) var (pct) var (chg) var (st) {\n    irin (\"Data: s=0\")\n  }\n  power.battery placeto (pct)\n  power.charging placeto (chg)\n  net.status placeto (st)\n\n  ui.screen (rings) title=\"Rings\" {\n    ui.text (thh) text=\"Theme\" size=16\n    ui.row (th1) gap=6 {\n      ui.button (tash) label=\"Ash\"\n      ui.button (tbirch) label=\"Birch\"\n      ui.button (tdusk) label=\"Dusk\"\n      ui.button (tember) label=\"Ember\"\n      ui.button (tink) label=\"Ink\"\n    }\n    ui.text (brh) text=\"Brightness\" size=16\n    ui.row (br1) gap=6 {\n      ui.button (b30) label=\"30%\"\n      ui.button (b60) label=\"60%\"\n      ui.button (b100) label=\"100%\"\n    }\n    ui.text (vlh) text=\"Volume\" size=16\n    ui.row (vl1) gap=6 {\n      ui.button (v0) label=\"Mute\"\n      ui.button (v5) label=\"50%\"\n      ui.button (v10) label=\"100%\"\n    }\n    ui.text (about) text=\"Samara OS 1.0.0\\nBattery ${pct}%  charging: ${chg}\\nNetwork: ${st}\" size=13\n    ui.button (rhome) label=\"Home\"\n  }\n  ui.on (tash) tap { sys.setting (theme) ash }\n  ui.on (tbirch) tap { sys.setting (theme) birch }\n  ui.on (tdusk) tap { sys.setting (theme) dusk }\n  ui.on (tember) tap { sys.setting (theme) ember }\n  ui.on (tink) tap { sys.setting (theme) ink }\n  ui.on (b30) tap { sys.setting (brightness) 0.3 }\n  ui.on (b60) tap { sys.setting (brightness) 0.6 }\n  ui.on (b100) tap { sys.setting (brightness) 1.0 }\n  ui.on (v0) tap { snd.volume (0) }\n  ui.on (v5) tap { snd.volume (0.5); snd.beep freq=660 ms=80 }\n  ui.on (v10) tap { snd.volume (1); snd.beep freq=660 ms=80 }\n  ui.on (rhome) tap { sys.home }\n  input.on (back) { sys.home }\n  ui.screen (rings)\n}|';'|\n\n// ---- Lens: camera (cam.*; the host falls back to a synthetic test pattern without getUserMedia) ----\n(Lens):-: {\n  [net: none] [poly: camera]\n  with var (s) var (shot) {\n    irin (\"Data: s=0\")\n  }\n  ui.screen (lens) title=\"Lens\" {\n    gfx.canvas (view) w=240 h=320\n    ui.row (lrow) gap=8 {\n      ui.button (lback) label=\"Rear\"\n      ui.button (lfront) label=\"Front\"\n      ui.button (lsnap) label=\"Shutter\" kind=primary\n    }\n    ui.button (lhome) label=\"Home\" kind=tonal\n  }\n  cam.open (back)\n  ui.on (lback) tap { cam.close; cam.open (back) }\n  ui.on (lfront) tap { cam.close; cam.open (front) }\n  ui.on (lsnap) tap {\n    cam.snap placeto (shot)\n    gfx.clear (view) color=#000\n    gfx.image (view) x=0 y=0 w=240 h=320 src=(shot)\n    snd.beep freq=1200 ms=40\n    input.haptic (20)\n  }\n  ui.on (lhome) tap { cam.close; sys.home }\n  input.on (back) { cam.close; sys.home }\n  ui.screen (lens)\n}|';'|\n",
  "phone/apps/drift.ashos": "// Drift - web browser for Samara OS (Ash node syntax).\n// net.fetch is host-mediated and can fail on CORS. Before each fetch Drift pre-loads an\n// in-app error page into (page); a successful fetch overwrites it, a failed one leaves it visible.\n// 'drift://home' is a built-in page (a string var), so it works fully offline.\n// History keeps 4 pages back (address + page text, so Back never refetches) and 1 forward.\nimport (SamaraHW)\n{{env:Samara}}\n[[script:drift-v1]]\n(Drift):-: {\n  [net: https] [poly: browser]\n  with var (s) var (addr) var (cur) var (page) var (homepage) var (fa) var (fp) var (st) var (ba1) var (bp1) var (ba2) var (bp2) var (ba3) var (bp3) var (ba4) var (bp4) var (bm1) var (bm2) var (bm3) var (bm4) var (bm5) var (bm6) {\n    irin (\"Data: s=0\")\n  }\n  thenplace \"https://api.github.com/zen\" placeto (bm1)\n  store.get (drift.bm.1) placeto (bm1)\n  thenplace \"https://en.wikipedia.org/api/rest_v1/page/summary/Ash_tree\" placeto (bm2)\n  store.get (drift.bm.2) placeto (bm2)\n  thenplace \"https://api.github.com/octocat\" placeto (bm3)\n  store.get (drift.bm.3) placeto (bm3)\n  thenplace \"https://catfact.ninja/fact\" placeto (bm4)\n  store.get (drift.bm.4) placeto (bm4)\n  thenplace \"https://httpbin.org/uuid\" placeto (bm5)\n  store.get (drift.bm.5) placeto (bm5)\n  thenplace \"https://example.com\" placeto (bm6)\n  store.get (drift.bm.6) placeto (bm6)\n  thenplace \"Drift - home\\n\\nWelcome. Type an address above and press Go, or open Bookmarks.\\n\\nBookmarks:\\n1) ${bm1}\\n2) ${bm2}\\n3) ${bm3}\\n4) ${bm4}\\n5) ${bm5}\\n6) ${bm6}\\n\\nThe last bookmark (example.com) does not allow cross-origin reads, so it shows Drift's in-app error page.\" placeto (homepage)\n  thenplace \"drift://home\" placeto (addr)\n  thenplace \"drift://home\" placeto (cur)\n  thenplace (homepage) placeto (page)\n  thenplace \"drift://home\" placeto (fa)\n  thenplace (homepage) placeto (fp)\n  thenplace \"drift://home\" placeto (ba1)\n  thenplace (homepage) placeto (bp1)\n  thenplace \"drift://home\" placeto (ba2)\n  thenplace (homepage) placeto (bp2)\n  thenplace \"drift://home\" placeto (ba3)\n  thenplace (homepage) placeto (bp3)\n  thenplace \"drift://home\" placeto (ba4)\n  thenplace (homepage) placeto (bp4)\n  net.status placeto (st)\n\n  ui.screen (browser) title=\"Drift\" {\n    ui.col (toolbar) gap=8 {\n      ui.row (nav) gap=8 {\n        ui.button (bback) label=\"‹\" kind=tool\n        ui.button (bfwd) label=\"›\" kind=tool\n        ui.button (brel) label=\"↻\" kind=tool\n        ui.button (bhome) label=\"⌂\" kind=tool\n      }\n      ui.row (addr) gap=8 {\n        ui.input (url) placeholder=\"Search or enter address\" value=(addr)\n        ui.button (bgo) label=\"Go\" kind=go\n      }\n    }\n    ui.text (view) text=(page) size=14\n    ui.row (foot) gap=8 {\n      ui.button (bstar) label=\"Bookmark\" kind=tab\n      ui.button (bmenu) label=\"Bookmarks\" kind=tab\n      ui.button (bquit) label=\"Exit\" kind=tab\n    }\n    ui.text (net) text=\"Network: ${st}\" size=11\n  }\n  ui.screen (marks) title=\"Bookmarks\" {\n    ui.button (m1) label=(bm1) kind=card\n    ui.button (m2) label=(bm2) kind=card\n    ui.button (m3) label=(bm3) kind=card\n    ui.button (m4) label=(bm4) kind=card\n    ui.button (m5) label=(bm5) kind=card\n    ui.button (m6) label=(bm6) kind=card\n    ui.button (mback) label=\"Back\" kind=tonal\n  }\n\n  ui.on (url) submit {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace \"\" placeto (fa)\n    thenplace \"\" placeto (fp)\n    thenplace (addr) placeto (cur)\n    ui.set (url) value=(addr)\n    thenplace \"Could not load ${addr}.\\n\\nThe site may block cross-origin requests (CORS), or you may be offline.\\nBuilt-in pages (drift://home) cannot be fetched: press Home.\\nTry a bookmark: they are known to allow browser requests.\" placeto (page)\n    ui.set (view) text=(page)\n    net.fetch ($addr) placeto (page)\n    ui.set (view) text=(page)\n    ui.screen (browser)\n  }\n  ui.on (bgo) tap {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace \"\" placeto (fa)\n    thenplace \"\" placeto (fp)\n    thenplace (addr) placeto (cur)\n    ui.set (url) value=(addr)\n    thenplace \"Could not load ${addr}.\\n\\nThe site may block cross-origin requests (CORS), or you may be offline.\\nBuilt-in pages (drift://home) cannot be fetched: press Home.\\nTry a bookmark: they are known to allow browser requests.\" placeto (page)\n    ui.set (view) text=(page)\n    net.fetch ($addr) placeto (page)\n    ui.set (view) text=(page)\n    ui.screen (browser)\n  }\n  ui.on (brel) tap {\n    thenplace (cur) placeto (addr)\n    thenplace (addr) placeto (cur)\n    ui.set (url) value=(addr)\n    thenplace \"Could not load ${addr}.\\n\\nThe site may block cross-origin requests (CORS), or you may be offline.\\nBuilt-in pages (drift://home) cannot be fetched: press Home.\\nTry a bookmark: they are known to allow browser requests.\" placeto (page)\n    ui.set (view) text=(page)\n    net.fetch ($addr) placeto (page)\n    ui.set (view) text=(page)\n    ui.screen (browser)\n  }\n  ui.on (bback) tap {\n    thenplace (cur) placeto (fa)\n    thenplace (page) placeto (fp)\n    thenplace (ba1) placeto (addr)\n    thenplace (ba1) placeto (cur)\n    thenplace (bp1) placeto (page)\n    thenplace (ba2) placeto (ba1)\n    thenplace (bp2) placeto (bp1)\n    thenplace (ba3) placeto (ba2)\n    thenplace (bp3) placeto (bp2)\n    thenplace (ba4) placeto (ba3)\n    thenplace (bp4) placeto (bp3)\n    ui.set (url) value=(addr)\n    ui.set (view) text=(page)\n  }\n  ui.on (bfwd) tap {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace (fa) placeto (addr)\n    thenplace (fa) placeto (cur)\n    thenplace (fp) placeto (page)\n    thenplace \"drift://home\" placeto (fa)\n    thenplace (homepage) placeto (fp)\n    ui.set (url) value=(addr)\n    ui.set (view) text=(page)\n  }\n  ui.on (bhome) tap {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace \"drift://home\" placeto (addr)\n    thenplace \"drift://home\" placeto (cur)\n    thenplace \"Drift - home\\n\\nWelcome. Type an address above and press Go, or open Bookmarks.\\n\\nBookmarks:\\n1) ${bm1}\\n2) ${bm2}\\n3) ${bm3}\\n4) ${bm4}\\n5) ${bm5}\\n6) ${bm6}\\n\\nThe last bookmark (example.com) does not allow cross-origin reads, so it shows Drift's in-app error page.\" placeto (homepage)\n    thenplace (homepage) placeto (page)\n    ui.set (url) value=(addr)\n    ui.set (view) text=(page)\n  }\n  ui.on (bstar) tap {\n    thenplace (bm5) placeto (bm6)\n    thenplace (bm4) placeto (bm5)\n    thenplace (bm3) placeto (bm4)\n    thenplace (bm2) placeto (bm3)\n    thenplace (bm1) placeto (bm2)\n    thenplace (cur) placeto (bm1)\n    store.set (drift.bm.1) with (bm1)\n    ui.set (m1) label=(bm1)\n    store.set (drift.bm.2) with (bm2)\n    ui.set (m2) label=(bm2)\n    store.set (drift.bm.3) with (bm3)\n    ui.set (m3) label=(bm3)\n    store.set (drift.bm.4) with (bm4)\n    ui.set (m4) label=(bm4)\n    store.set (drift.bm.5) with (bm5)\n    ui.set (m5) label=(bm5)\n    store.set (drift.bm.6) with (bm6)\n    ui.set (m6) label=(bm6)\n    sys.notify (\"Bookmarked\") title=\"Drift\"\n  }\n  ui.on (bmenu) tap { ui.screen (marks) }\n  ui.on (mback) tap { ui.screen (browser) }\n  ui.on (m1) tap {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace \"\" placeto (fa)\n    thenplace \"\" placeto (fp)\n    thenplace (bm1) placeto (addr)\n    thenplace (addr) placeto (cur)\n    ui.set (url) value=(addr)\n    thenplace \"Could not load ${addr}.\\n\\nThe site may block cross-origin requests (CORS), or you may be offline.\\nBuilt-in pages (drift://home) cannot be fetched: press Home.\\nTry a bookmark: they are known to allow browser requests.\" placeto (page)\n    ui.set (view) text=(page)\n    net.fetch ($addr) placeto (page)\n    ui.set (view) text=(page)\n    ui.screen (browser)\n  }\n  ui.on (m2) tap {\n    thenplace (ba3) placeto (ba4)\n    thenplace (bp3) placeto (bp4)\n    thenplace (ba2) placeto (ba3)\n    thenplace (bp2) placeto (bp3)\n    thenplace (ba1) placeto (ba2)\n    thenplace (bp1) placeto (bp2)\n    thenplace (cur) placeto (ba1)\n    thenplace (page) placeto (bp1)\n    thenplace \"\" placeto (fa)\n    thenplace \"\" placeto (fp)\n    thenplace (bm2) placeto (addr)\n    thenplace (addr) placeto (cur)\n    ui.set (url) value=(addr)\n    thenplace \"Could not load ${addr}.\\n\\nThe site may block cross-origin requests (CORS), or you may be offline.\\nBuilt-in pages (drift://home) cannot be fetched: press Home.\\nTry a bookmark: they are known to allow browser requests.\" placeto (page)\n    ui.set (view) text=(page)\n    net.fetch ($addr) placeto (page)\n    ui.set (view) text=(page)\n    ui.screen (browser)\n  }\n  ui.on (m3) tap {\n    thenplace (ba3) placeto (ba4)\n    th